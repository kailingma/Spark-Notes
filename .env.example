# Spark Notes — environment
#
# Copy to `.env` in this same directory (the repository root) and edit:
#
#     cp .env.example .env
#
# Every setting here has a working default, so an empty `.env` — or none at
# all — still runs. Uncomment only what you want to change. A variable already
# set in your real shell environment wins over this file, so a one-off
# `PORT=4000 npm run dev` still works.
#
# `.env` is gitignored. Do not commit it.


# ---------------------------------------------------------------------------
# Where your notes live
# ---------------------------------------------------------------------------

# The notes directory. THIS IS THE DATABASE — a plain folder of markdown, with
# no index and nothing else to keep in step. Point it at notes you already have
# and Spark will read them as they are.
# Relative paths resolve against the repository root.
#SPARK_SPACE=./space
#SPARK_SPACE=~/Documents/notes

# Server-side state: the GitHub token and the AI key, both at mode 0600.
# Deliberately never inside the space, so sync can't push your credentials.
#SPARK_STATE=./.spark

# Display name for the space, shown in the interface.
#SPARK_SPACE_NAME=Spark

# Server port. In dev the web client is on :3000 and proxies here.
#PORT=3001


# ---------------------------------------------------------------------------
# AI  (optional — everything works without it)
# ---------------------------------------------------------------------------
#
# You do not have to set any of this here. Settings → AI in the app writes the
# same configuration to `.spark/ai.json` at mode 0600, and what you save there
# takes precedence over this file. Use these variables when you would rather
# provision the server than click through the UI.
#
# Every AI call is something you triggered. Nothing watches your keystrokes and
# nothing runs on a timer.

# "openai" for anything speaking the OpenAI-compatible API, "anthropic" for the
# Claude Messages API. Left unset, it is inferred from whichever key you set.
#SPARK_AI_PROVIDER=openai

# The key. Only the one matching your provider is used.
#OPENAI_API_KEY=sk-...
#ANTHROPIC_API_KEY=sk-ant-...

# Model id, exactly as your provider names it.
#SPARK_AI_MODEL=gpt-5
#SPARK_AI_MODEL=claude-opus-5

# Base URL. Leave unset for the provider's own. Set it to reach any
# OpenAI-compatible server — OpenRouter, Groq, Together — or a local runtime,
# in which case nothing leaves your machine and no key is needed.
#SPARK_AI_ENDPOINT=https://openrouter.ai/api/v1
#SPARK_AI_ENDPOINT=http://localhost:11434/v1     # Ollama
#SPARK_AI_ENDPOINT=http://localhost:1234/v1      # LM Studio


# ---------------------------------------------------------------------------
# GitHub sync  (optional)
# ---------------------------------------------------------------------------
#
# Only needed for "Connect GitHub" in the sync panel. Spark runs in online mode
# without any of this; sync mode adds git on top and stays opt-in.
#
# Create an OAuth app at https://github.com/settings/developers with the
# callback URL set to  <SPARK_ORIGIN>/api/auth/github/callback

#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=

# The public origin, used to build that callback URL. Change it if you are not
# on localhost.
#SPARK_ORIGIN=http://localhost:3001

# Author recorded on sync commits.
#SPARK_GIT_NAME=Spark Notes
#SPARK_GIT_EMAIL=spark@localhost
#SPARK_GIT_BRANCH=main


# ---------------------------------------------------------------------------
# Rarely needed
# ---------------------------------------------------------------------------

# In production the server also serves the built client from here.
#SPARK_WEB_DIST=apps/web/dist
