{
  "name": "spark-notes",
  "version": "0.1.0",
  "private": true,
  "description": "Spark Notes — a low-friction, markdown-at-heart notes platform.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace @spark/server",
    "dev:web": "npm run dev --workspace @spark/web",
    "build": "npm run build --workspace @spark/web",
    "start": "npm run start --workspace @spark/server",
    "typecheck": "tsc --noEmit",
    "fonts": "node scripts/fetch-fonts.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true
  }
}
